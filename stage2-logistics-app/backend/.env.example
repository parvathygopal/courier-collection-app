PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logistics_db"

# Stage 3 Integration - ETL Push Configuration
# Enable ETL push job to send package updates to Stage 1
ENABLE_STAGE3_PUSH_ETL=true

# ETL_PUSH_INTERVAL_MS: How often to push updates to Stage 1 (in milliseconds)
# Development: 60000 (60 seconds) - for frequent testing
# Production: 21600000 (6 hours) - for battery/network efficiency
# Default: 21600000 (6 hours)
ETL_PUSH_INTERVAL_MS=60000

# Whether to run the ETL push job immediately on app startup
ETL_PUSH_RUN_ON_START=false

# Stage 1 ETL Configuration
# URL where Stage 1 raw-updates endpoint is located
STAGE1_RAW_UPDATES_URL=http://localhost:3001/raw-updates

# API key for authenticating ETL push requests to Stage 1
STAGE1_RAW_UPDATES_API_KEY=7d8f0a1c9e5b4d3a2f1e8c7b6a5d4e3f1a2b3c4d5e6f7a8b

# Signing secret for HMAC signature generation on ETL push requests
STAGE1_SIGNING_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f

# Shared HMAC secret for webhook signature validation
STAGE2_TO_STAGE1_HMAC_SECRET=9a8b7c6d5e4f3a2b1c0d9e8f7a6b5c4d3e2f1a0b9c8d7e6f

# Public URL for the logistics webhook used in Stage 1 registration
# Falls back to http://localhost:PORT/webhooks/packages if not set
# Use this when running on a public domain (e.g., https://logistics.example.com/webhooks/packages)
LOGISTICS_WEBHOOK_PUBLIC_URL=http://localhost:3000/webhooks/packages
