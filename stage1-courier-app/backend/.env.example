PORT=3001
DATABASE_URL=postgres://user:password@localhost:5432/courier_db

# Webhook Configuration - Points to Stage 2 (Logistics App)
STAGE2_WEBHOOK_URL=http://localhost:3000/webhooks/packages

# ETL Raw Updates Configuration
# Interval for processing incoming ETL updates from Stage 2 (in milliseconds)
# Development: 60000 (60 seconds) - for frequent testing
# Production: 360000 (6 minutes) - for normal operation
# Default: 60000
RAW_UPDATES_ETL_INTERVAL_MS=60000

# Maximum number of raw updates to process in a single batch
RAW_UPDATES_ETL_BATCH_SIZE=100

# API Key and Signing Secret for incoming raw updates from Stage 2
STAGE1_RAW_UPDATES_API_KEY=stage2_key_dev
STAGE1_SIGNING_SECRET=stage1_to_stage2_secret_dev

# Shared HMAC secret for webhook signature validation
STAGE2_TO_STAGE1_HMAC_SECRET=stage2_to_stage1_secret_dev

# Integration Admin Key for securing registration endpoints
# Used to protect GET/PUT /integrations/logistics-webhook endpoints
INTEGRATION_ADMIN_KEY=admin_key_dev
