generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum PackageStatus {
  CREATED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  RETURNED
  CANCELLED
}

enum WebhookOutboxStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Package {
  id                String         @id @default(uuid())
  trackingId        String         @unique
  senderAddress     String
  receiverAddress   String
  sourceRegion      String
  destinationRegion String
  weight            Float
  currentStatus     PackageStatus  @default(CREATED)
  currentLocation   String
  createdAt         DateTime       @default(now())

  sale              Sale?
  statusHistory     StatusHistory[]

  @@map("packages")
}

model Sale {
  id        String   @id @default(uuid())
  packageId String   @unique
  amount    Float
  package   Package  @relation(fields: [packageId], references: [id])

  @@map("sales")
}

model StatusHistory {
  id         String        @id @default(uuid())
  packageId  String
  status     PackageStatus
  location   String
  timestamp  DateTime      @default(now())
  package    Package       @relation(fields: [packageId], references: [id])

  @@index([packageId])
  @@map("status_history")
}

model RawUpdate {
  id            String    @id @default(uuid())
  rawData       Json
  processed     Boolean   @default(false)
  processedAt   DateTime?
  error         String?
  attempts      Int       @default(0)
  maxAttempts   Int       @default(5)
  nextAttemptAt DateTime  @default(now())
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([processed, nextAttemptAt, createdAt])
  @@map("raw_updates")
}

model ProcessedEtlUpdate {
  updateId    String   @id
  rawUpdateId String?
  processedAt DateTime @default(now())

  @@map("processed_etl_updates")
}

model IntegrationConfig {
  key                String   @id
  logisticsWebhookUrl String
  logisticsApiKey     String
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@map("integration_configs")
}

model WebhookOutbox {
  id            String             @id @default(uuid())
  trackingId    String             @unique
  payload       Json
  status        WebhookOutboxStatus @default(PENDING)
  attempts      Int                @default(0)
  maxAttempts   Int                @default(5)
  nextAttemptAt DateTime           @default(now())
  processedAt   DateTime?
  lastError     String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([status, nextAttemptAt, createdAt])
  @@map("webhook_outbox")
}